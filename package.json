    "db:studio": "drizzle-kit studio",
    "test:rls": "tsx scripts/test-rls.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:readiness": "tsx scripts/test-production-readiness.ts",
    "worker": "node dist/worker/index.js",
    "worker:dev": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
