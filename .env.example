# ==============================================================================
# FormFlow Environment Variables Specification
# ==============================================================================
# Required in Production: Marked with [REQUIRED - PRODUCTION]
# Development Only:      Marked with [DEV ONLY]
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION] 'production' in live environments; 'development' locally
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION & DEV]
# Owner role — used exclusively for running database migrations (DDL operations).
DATABASE_URL=postgresql://formflow_owner:formflow_dev@localhost:5432/formflow

# [REQUIRED - PRODUCTION & DEV]
# App role — RLS-enforced, used by every authenticated tenant request via withOrg().
# Never bypasses row-level security, even for its own connection owner.
APP_DATABASE_URL=postgresql://formflow_app:formflow_app_dev@localhost:5432/formflow

# [REQUIRED - PRODUCTION & DEV]
# Service role — BYPASSRLS, used only by trusted server paths (Clerk webhook handlers,
# unauthenticated /f/[slug] public form inspection, and system provisioning).
SERVICE_DATABASE_URL=postgresql://formflow_service:formflow_service_dev@localhost:5432/formflow

# [REQUIRED - PRODUCTION]
# Passwords configured for Postgres roles created during migration (migrate.ts).
# In production, migrations will FAIL if these are omitted.
# In development, these default safely to 'formflow_app_dev' and 'formflow_service_dev'.
APP_DB_PASSWORD=
SERVICE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Redis Cache & Sliding-Window Rate Limiting
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION & DEV]
# Redis connection URL. For TLS enabled in AWS ElastiCache, use rediss://...
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Clerk Authentication & Multi-Tenancy
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION & DEV]
# From the Clerk dashboard (Configure > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# [REQUIRED - PRODUCTION]
# Svix webhook signing secret from Clerk Dashboard -> Webhooks.
# Webhook sync verifies signatures against this secret before writing orgs/members.
CLERK_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 5. File Storage Configuration
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION & DEV]
# Storage driver: 's3' (production required) or 'local' (local development only).
# Setting STORAGE_DRIVER=local in production will fail immediately.
STORAGE_DRIVER=local

# [DEV ONLY]
# Directory for local file storage fallback when STORAGE_DRIVER=local.
UPLOAD_DIR=./uploads

# [REQUIRED - PRODUCTION when STORAGE_DRIVER=s3]
# AWS S3 Bucket Name for direct presigned client uploads & downloads.
SUBMISSIONS_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 6. AWS & SQS Async Queue Configuration
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION]
# AWS Region for S3 and SQS operations (e.g. ap-south-1, us-east-1).
AWS_REGION=ap-south-1

# [REQUIRED - PRODUCTION (Web + Worker)]
# SQS Queue URL for asynchronous submission processing.
SUBMISSIONS_QUEUE_URL=

# ------------------------------------------------------------------------------
# 7. Generative AI Form Generation
# ------------------------------------------------------------------------------
# [REQUIRED - PRODUCTION]
# Google Gemini API Key for natural language form builder generation.
# In production, AI generation will fail with an error if no real key is configured.
GEMINI_API_KEY=

# [OPTIONAL]
# Google Gemini model override (defaults to gemini-flash-latest).
GEMINI_MODEL=gemini-flash-latest

# [OPTIONAL]
# OpenAI API Key as optional secondary backup provider.
OPENAI_API_KEY=
