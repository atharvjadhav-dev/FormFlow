# Owner role — used only for running migrations (drizzle-kit generate/push).
DATABASE_URL=postgresql://formflow_owner:formflow_dev@localhost:5432/formflow

# App role — RLS-enforced, used by every normal request via withOrg().
# Never bypasses row-level security, even for its own connection owner.
APP_DATABASE_URL=postgresql://formflow_app:formflow_app_dev@localhost:5432/formflow

# Service role — BYPASSRLS, used only by trusted server-side paths (Clerk
# webhook handlers that create orgs/members, admin/maintenance scripts).
# Never used to serve a tenant-facing request.
SERVICE_DATABASE_URL=postgresql://formflow_service:formflow_service_dev@localhost:5432/formflow

REDIS_URL=redis://localhost:6379

# From the Clerk dashboard (Configure > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# From Configure > Webhooks, after pointing an endpoint at /api/webhooks/clerk
# Subscribe to: organization.created, organization.updated, organization.deleted,
# organizationMembership.created, organizationMembership.updated, organizationMembership.deleted
CLERK_WEBHOOK_SECRET=

# Filled in during Phase 4/5 (S3, SQS)
AWS_REGION=ap-south-1
SUBMISSIONS_BUCKET_NAME=
SUBMISSIONS_QUEUE_URL=

# AI Form Generation (Phase 9)
GEMINI_API_KEY=

