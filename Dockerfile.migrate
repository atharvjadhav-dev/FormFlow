# ==============================================================================
# FormFlow Database Migration Runner - Production Multi-Stage Dockerfile
# ==============================================================================
# - Multi-stage build on Node.js 20 Alpine
# - Zero devDependencies / zero tsx in runner stage
# - Standalone migration execution: node dist/db/migrate.js
# - Non-root user: migrate (UID 1001)
# - Idempotent DDL, roles, permissions, and RLS policy setup
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Alpine Image
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ------------------------------------------------------------------------------
# Stage 2: Build Dependencies
# ------------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 3: Production-Only Dependencies (Prune devDependencies)
# ------------------------------------------------------------------------------
FROM deps AS prod-deps
WORKDIR /app
RUN npm prune --production

# ------------------------------------------------------------------------------
# Stage 4: Standalone Migration Runner Compilation
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run build:standalone

# ------------------------------------------------------------------------------
# Stage 5: Production Migration Runner
# ------------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

# Security: Create non-root system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 migrate

ENV NODE_ENV=production

# Copy only production dependencies and compiled standalone migration files
COPY --from=prod-deps --chown=migrate:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=migrate:nodejs /app/dist/db ./dist/db
COPY --from=builder --chown=migrate:nodejs /app/package.json ./package.json

# Security: Run as non-root user
USER migrate

# Runtime command: node dist/db/migrate.js
CMD ["node", "dist/db/migrate.js"]
